menu "Virtual File System"

config HOMECORE_VFS
    bool "Enable Virtual File System"
    default y
    help
        Enable the virtual file system (VFS) subsystem.

if HOMECORE_VFS

config HOMECORE_VFS_MAX_DIRECTORIES
    int "Maximum number of user-created RAM directories"
    default 16
    range 1 64

config HOMECORE_VFS_MAX_RAM_FILES
    int "Maximum number of RAM files"
    default 16
    range 1 64

config HOMECORE_VFS_MAX_FILE_SIZE
    int "Maximum size of each RAM file in bytes"
    default 4096
    range 1 32768

config HOMECORE_VFS_MAX_OPEN_FILES
    int "Maximum number of open files"
    default 16
    range 4 64
    help
        Set the maximum number of files that can be opened simultaneously.

endif

endmenu